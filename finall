    <button class="menu-btn" aria-label="Open navigation" aria-expanded="false">☰</button>

    <nav id="nav">
        <a href="#home">HOME</a>
        <a href="#about">ABOUT</a>
        <a href="#vision">VISION & MISSION</a>
        <a href="#values">VALUES</a>
        <a href="#buildings">BUILDINGS</a>
        <a href="#facilities">FACILITIES</a>
        <a href="#principal">LEADERSHIP</a>
    </nav>
</header>

<main>

<section class="hero" id="home">
    <div class="hero-content">
        <div class="welcome">Welcome to</div>
        <h1>TAGUIG NATIONAL<br>HIGH SCHOOL</h1>
        <p>
            Looking Beyond the Horizon — empowering Filipino learners
            to discover their potential, embrace opportunities, and
            contribute meaningfully to the future of our nation.
        </p>
        <a class="hero-btn" href="#about">DISCOVER OUR SCHOOL ↓</a>
    </div>
</section>

<section class="section about" id="about">
    <img src="principalOffice.jpg" alt="TNHS Principal's Office">

    <div class="about-copy">
        <div class="eyebrow">GET TO KNOW OUR SCHOOL</div>
        <h2>A place where learning shapes the future.</h2>

        <p>
            Taguig National High School, formerly known as Taguig
            Municipal High School, is one of the educational
            institutions that has played an important role in the
            development of education in Taguig City.
        </p>

        <p>
            Established on January 8, 1980, as Fort Bonifacio College
            Annex, the institution eventually developed into an
            independent school serving generations of learners.
        </p>

        <p>
            Today, the school continues to uphold quality, inclusive,
            and learner-centered education. Its guiding philosophy,
            "Looking Beyond the Horizon," represents its commitment
            to helping students pursue opportunities and aspire
            toward a better future.
        </p>

        <div class="info-strip">
            <div>
                <strong>1980</strong>
                <span>Year established</span>
            </div>
            <div>
                <strong>TNHS</strong>
                <span>Taguig City</span>
            </div>
        </div>
    </div>
</section>

<section class="section dark" id="vision">
    <div class="section-head">
        <div class="eyebrow">OUR PURPOSE</div>
        <h2>Our Vision and Mission</h2>
        <p>The guiding principles that shape our school community and the future of every learner.</p>
    </div>

    <div class="cards">
        <article class="info-card">
            <h3>Our Vision</h3>
            <p>
                We dream of Filipinos who passionately love their
                country and whose values and competencies enable them
                to realize their full potential and contribute
                meaningfully to building the nation.
            </p>
            <br>
            <p>
                As a learner-centered public institution, the
                Department of Education continuously improves itself
                to better serve its stakeholders.
            </p>
        </article>

        <article class="info-card">
            <h3>Our Mission</h3>
            <p>
                To protect and promote the right of every Filipino
                to quality, equitable, culture-based, and complete
                basic education where:
            </p>

            <ul>
                <li>Students learn in a child-friendly, safe, and motivating environment.</li>
                <li>Teachers facilitate learning and nurture every learner.</li>
                <li>Administrators and staff ensure a supportive learning environment.</li>
                <li>Families and communities actively engage in developing lifelong learners.</li>
            </ul>
        </article>
    </div>
</section>

<section class="section" id="values">
    <div class="section-head">
        <div class="eyebrow">WHAT WE STAND FOR</div>
        <h2>Our Core Values</h2>
        <p>Four fundamental values that shape responsible and compassionate Filipino citizens.</p>
    </div>

    <div class="values">
        <div class="value-card">
            <div class="value-icon">✦</div>
            <h3>Maka-Diyos</h3>
        </div>

        <div class="value-card">
            <div class="value-icon">♡</div>
            <h3>Makatao</h3>
        </div>

        <div class="value-card">
            <div class="value-icon">❧</div>
            <h3>Makakalikasan</h3>
        </div>

        <div class="value-card">
            <div class="value-icon">⚑</div>
            <h3>Makabansa</h3>
        </div>
    </div>
</section>

<section class="section" id="buildings" style="background:var(--pale)">
    <div class="section-head">
        <div class="eyebrow">LEARNING SPACES</div>
        <h2>Our Grade Level Buildings</h2>
        <p>Explore the buildings where students learn, grow, and prepare for their next journey.</p>
    </div>

    <div class="grid-cards">
        <article class="place-card">
            <img src="gr7.jpg" alt="Grade 7 Building">
            <div class="card-body">
                <h3>Grade 7 Building</h3>
                <p>A welcoming learning environment where students begin their junior high school journey.</p>
            </div>
        </article>

        <article class="place-card">
            <img src="gr8.jpg" alt="Grade 8 Building">
            <div class="card-body">
                <h3>Grade 8 Building</h3>
                <p>A place where students continue developing their knowledge, confidence, and abilities.</p>
            </div>
        </article>

        <article class="place-card">
            <img src="gr9.jpg" alt="Grade 9 Building">
            <div class="card-body">
                <h3>Grade 9 Building</h3>
                <p>An environment that encourages academic growth, creativity, and collaboration.</p>
            </div>
        </article>

        <article class="place-card">
            <img src="gr10.jpg" alt="Grade 10 Building">
            <div class="card-body">
                <h3>Grade 10 Building</h3>
                <p>Preparing students for greater responsibilities and their next educational journey.</p>
            </div>
        </article>
    </div>
</section>

<section class="section" id="facilities">
    <div class="section-head">
        <div class="eyebrow">CAMPUS LIFE</div>
        <h2>Our School Facilities</h2>
        <p>Explore the offices and learning spaces that support the school community.</p>
    </div>

    <div class="grid-cards">
        <article class="place-card">
            <img src="principalOffice.jpg" alt="Principal's Office">
            <div class="card-body">
                <h3>Principal’s Office</h3>
                <p>The school office that supports leadership, administration, and school operations.</p>
            </div>
        </article>

        <article class="place-card">
            <img src="guidance.jpg" alt="Guidance Office">
            <div class="card-body">
                <h3>Guidance Office</h3>
                <p>A supportive space offering student counseling, academic advising, and personal development.</p>
            </div>
        </article>

        <article class="place-card">
            <img src="clinic.jpg" alt="School Clinic">
            <div class="card-body">
                <h3>Clinic</h3>
                <p>A school facility that supports students' health and well-being.</p>
            </div>
        </article>

        <article class="place-card">
            <img src="GreenLab.jpg" alt="GreenLab">
            <div class="card-body">
                <h3>GreenLab</h3>
                <p>A learning space that supports environmental awareness and hands-on learning.</p>
            </div>
        </article>
    </div>
</section>

<section class="section" style="background:var(--pale)" id="activities">
    <div class="section-head">
        <div class="eyebrow">LIFE BEYOND THE CLASSROOM</div>
        <h2>School Activities and Experiences</h2>
        <p>Learning, creativity, teamwork, and leadership come together through school activities.</p>
    </div>

    <div class="activities">
        <div class="activity">
            <span class="number">01</span>
            <div>
                <h3>School Booths</h3>
                <p>Creative displays, games, and student-made activities during school events.</p>
            </div>
        </div>

        <div class="activity">
            <span class="number">02</span>
            <div>
                <h3>Intramurals</h3>
                <p>Friendly competitions, teamwork, school spirit, and sportsmanship.</p>
            </div>
        </div>

        <div class="activity">
            <span class="number">03</span>
            <div>
                <h3>Sports Activities</h3>
                <p>Activities that promote teamwork, discipline, and active living.</p>
            </div>
        </div>

        <div class="activity">
            <span class="number">04</span>
            <div>
                <h3>Cultural Programs</h3>
                <p>Celebrating Filipino culture, traditions, creativity, and performances.</p>
            </div>
        </div>

        <div class="activity">
            <span class="number">05</span>
            <div>
                <h3>Science Fair</h3>
                <p>Discovering new ideas through experiments, exhibits, and competitions.</p>
            </div>
        </div>

        <div class="activity">
            <span class="number">06</span>
            <div>
                <h3>Talent Portions</h3>
                <p>Showcasing creativity through art, music, dancing, and performances.</p>
            </div>
        </div>

        <div class="activity">
            <span class="number">07</span>
            <div>
                <h3>Editorial Writing</h3>
                <p>Developing knowledge, vocabulary, and imagination through reading and writing.</p>
            </div>
        </div>

        <div class="activity">
            <span class="number">08</span>
            <div>
                <h3>Environmental Programs</h3>
                <p>Cleanliness drives, gardening, recycling, and environmental awareness.</p>
            </div>
        </div>

        <div class="activity">
            <span class="number">09</span>
            <div>
                <h3>School Organizations</h3>
                <p>Building leadership, confidence, communication, and teamwork.</p>
            </div>
        </div>
    </div>
</section>

<section class="section principal" id="principal">
    <img src="principal.jpg" alt="School Principal">

    <div>
        <div class="eyebrow">SCHOOL LEADERSHIP</div>
        <h2>Our School Principal</h2>
        <p>Guiding the school community in providing quality and learner-centered education.</p>

        <h3>Mr. Nolito R. Estilles</h3>
        <p>Current School Principal</p>
    </div>
</section>

</main>

<footer>
    <div class="footer-top">
        <div>
            <h3>TAGUIG NATIONAL HIGH SCHOOL</h3>
            <div class="motto">LOOKING BEYOND THE HORIZON</div>
        </div>

        <p>Empowering learners. Building futures.</p>
    </div>

    <div class="footer-bottom">
        <span>© 2026 Taguig National High School. All Rights Reserved.</span>
        <span>Taguig City, Philippines</span>
    </div>
</footer>

<script>
const menuButton = document.querySelector('.menu-btn');
const nav = document.getElementById('nav');

menuButton.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    menuButton.setAttribute('aria-expanded', String(open));
});

nav.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
        nav.classList.remove('open');
        menuButton.setAttribute('aria-expanded', 'false');
    });
});
</script>

