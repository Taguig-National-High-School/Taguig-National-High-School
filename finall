<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta property="og:type" content="website">
<meta property="og:title" content="Taguig National High School">
<meta property="og:description" content="Looking Beyond the Horizon">
<meta property="og:image" content="https://taguig-national-high-school.github.io/Taguig-National-High-School/hero_section.jpg">
<meta property="og:url" content="https://taguig-national-high-school.github.io/Taguig-National-High-School/">
<title>Taguig National High School</title>

<style>
:root {
    --navy: #09264a;
    --navy2: #123b68;
    --gold: #e1b94f;
    --pale: #f4f7fb;
    --ink: #17283d;
    --muted: #65758a;
    --white: #fff;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: var(--ink);
    background: #fff;
    line-height: 1.6;
}

.topbar {
    background: var(--navy);
    color: #eaf0f8;
    padding: 8px 6%;
    font-size: 11px;
    letter-spacing: .5px;
    display: flex;
    justify-content: space-between;
    gap: 15px;
}

header {
    height: auto;
    min-height: 82px;
    padding: 14px 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 20;
    box-shadow: 0 3px 15px #09264a12;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--navy);
    font-weight: 800;
    font-size: 14px;
    line-height: 1.25;
    letter-spacing: .4px;
}

.brand img {
    width: 49px;
    height: 49px;
    object-fit: contain;
}

.brand small {
    display: block;
    color: #987321;
    font-size: 9px;
    letter-spacing: 1.7px;
    margin-top: 4px;
}

nav {
    display: flex;
    align-items: center;
    gap: 23px;
}

nav a {
    text-decoration: none;
    color: #34465d;
    font-size: 11px;
    font-weight: 700;
    transition: .2s;
}

nav a:hover {
    color: #b48b27;
}

.menu-btn {
    display: none;
    border: 0;
    background: none;
    color: var(--navy);
    font-size: 25px;
}

.hero {
    min-height: 540px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    padding: 75px 7%;
    position: relative;
    background: linear-gradient(110deg,rgba(5,25,51,.88),rgba(7,36,68,.63)),url('hero_section.jpg') center/cover no-repeat;
}

.hero:after {
    content: "";
    position: absolute;
    inset: 16px;
    border: 1px solid #ffffff55;
    pointer-events: none;
}

.hero-content {
    max-width: 850px;
    position: relative;
    z-index: 1;
}

.hero .welcome {
    color: var(--gold);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
}

.hero h1 {
    font-size: clamp(35px,6vw,67px);
    line-height: 1.12;
    margin: 18px 0 14px;
    font-weight: 800;
    letter-spacing: 1px;
}

.hero p {
    font-size: clamp(15px,2vw,19px);
    color: #f0f4f9;
    max-width: 690px;
    margin: 0 auto;
}

.hero-btn {
    display: inline-block;
    margin-top: 28px;
    background: var(--gold);
    color: var(--navy);
    font-weight: 800;
    text-decoration: none;
    padding: 13px 25px;
    border-radius: 4px;
    font-size: 12px;
    letter-spacing: .6px;
    transition: .2s;
}

.hero-btn:hover {
    background: white;
    transform: translateY(-2px);
}

.section {
    padding: 76px 7%;
}

.section-head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 38px;
}

.section-head .eyebrow {
    font-size: 11px;
    font-weight: 800;
    color: #a47b1f;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.section-head h2 {
    font-size: clamp(28px,4vw,40px);
    line-height: 1.2;
    color: var(--navy);
    margin: 9px 0 10px;
}

.section-head p {
    font-size: 14px;
    color: var(--muted);
}

.about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    background: var(--pale);
}

.about img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 14px 14px 0 var(--gold);
}

.about-copy .eyebrow {
    font-size: 11px;
    font-weight: 800;
    color: #a47b1f;
    letter-spacing: 2px;
}

.about-copy h2 {
    font-size: clamp(29px,4vw,42px);
    line-height: 1.2;
    color: var(--navy);
    margin: 12px 0 18px;
}

.about-copy p {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 13px;
    line-height: 1.85;
}

.info-strip {
    display: flex;
    gap: 25px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid #dce4ed;
}

.info-strip strong {
    font-size: 27px;
    color: var(--navy);
    display: block;
}

.info-strip span {
    font-size: 10px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.dark {
    background: var(--navy);
    color: white;
}

.dark .section-head h2 {
    color: white;
}

.dark .section-head p {
    color: #d1dbea;
}

.cards {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 22px;
}

.info-card {
    background: #fff;
    color: var(--ink);
    border-radius: 8px;
    padding: 30px;
    border-top: 4px solid var(--gold);
    box-shadow: 0 7px 22px #001a3517;
}

.info-card h3 {
    font-size: 24px;
    color: var(--navy);
    margin-bottom: 12px;
}

.info-card p,
.info-card li {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.85;
}

.info-card ul {
    padding-left: 19px;
    margin-top: 10px;
}

.values {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 17px;
}

.value-card {
    background: white;
    text-align: center;
    padding: 27px 15px;
    border-radius: 8px;
    border-bottom: 4px solid var(--gold);
    box-shadow: 0 5px 20px #09264a12;
}

.value-icon {
    height: 58px;
    width: 58px;
    margin: 0 auto 13px;
    border-radius: 50%;
    background: #eaf0f7;
    color: var(--navy);
    display: grid;
    place-items: center;
    font-size: 24px;
    font-weight: 800;
}

.value-card h3 {
    font-size: 17px;
    color: var(--navy);
}

.grid-cards {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 22px;
}

.place-card {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 5px 20px #09264a16;
    transition: .25s;
}

.place-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 25px #09264a22;
}

.place-card img {
    width: 100%;
    height: 215px;
    object-fit: cover;
    display: block;
    background: #e7edf4;
}

.place-card .card-body {
    padding: 19px 20px 22px;
}

.place-card h3 {
    color: var(--navy);
    font-size: 17px;
    margin-bottom: 6px;
}

.place-card p {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.7;
}

.activities {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 17px;
}

.activity {
    background: #fff;
    border: 1px solid #e3e9f0;
    border-radius: 7px;
    padding: 22px;
    display: flex;
    gap: 15px;
    align-items: flex-start;
}

.activity .number {
    flex: 0 0 38px;
    height: 38px;
    border-radius: 50%;
    background: #edf2f8;
    color: var(--navy);
    display: grid;
    place-items: center;
    font-weight: 800;
}

.activity h3 {
    color: var(--navy);
    font-size: 15px;
    margin-bottom: 4px;
}

.activity p {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.7;
}

.principal {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 45px;
    align-items: center;
    background: var(--pale);
}

.principal img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    border-radius: 8px;
    border: 7px solid white;
    box-shadow: 0 7px 25px #09264a1a;
}

.principal .eyebrow {
    color: #a47b1f;
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 800;
}

.principal h2 {
    font-size: clamp(28px,4vw,39px);
    color: var(--navy);
    margin: 10px 0;
}

.principal h3 {
    font-size: 20px;
    color: var(--navy);
    margin-top: 18px;
}

.principal p {
    font-size: 13px;
    color: var(--muted);
}

footer {
    background: #061b35;
    color: #fff;
    padding: 42px 7% 20px;
}

.footer-top {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    align-items: center;
    padding-bottom: 25px;
    border-bottom: 1px solid #ffffff2a;
}

footer h3 {
    font-size: 19px;
    letter-spacing: .5px;
}

footer .motto {
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 2px;
    margin-top: 5px;
}

footer p {
    color: #c5d0df;
    font-size: 12px;
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding-top: 18px;
    color: #aebbd0;
    font-size: 11px;
}

@media(max-width:900px) {
    nav {
        gap: 13px;
    }

    nav a {
        font-size: 10px;
    }

    .grid-cards {
        grid-template-columns: repeat(2,1fr);
    }

    .activities {
        grid-template-columns: repeat(2,1fr);
    }
}

@media(max-width:650px) {
    .topbar {
        justify-content: center;
        text-align: center;
    }

    .topbar span:last-child {
        display: none;
    }

    header {
        flex-wrap: wrap;
    }

    .menu-btn {
        display: block;
    }

    nav {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: flex-start;
        padding: 17px 0 5px;
        gap: 16px;
    }

    nav.open {
        display: flex;
    }

    .hero {
        min-height: 490px;
    }

    .section {
        padding: 60px 6%;
    }

    .about,
    .principal {
        grid-template-columns: 1fr;
        gap: 32px;
    }

    .about img {
        height: 280px;
        order: 2;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .values {
        grid-template-columns: repeat(2,1fr);
    }

    .grid-cards,
    .activities {
        grid-template-columns: 1fr;
    }

    .place-card img {
        height: 230px;
    }

    .principal img {
        max-width: 280px;
        height: 310px;
    }

    .footer-top,
    .footer-bottom {
        flex-direction: column;
        align-items: flex-start;
    }
}
</style>
</head>

<body>

<div class="topbar">
    <span>Department of Education · Taguig City</span>
    <span>Taguig National High School</span>
</div>

<header>
    <a class="brand" href="#home">
        <img src="schoolLogo.png" alt="TNHS logo" onerror="this.style.display='none'">
        <span>
            TAGUIG NATIONAL HIGH SCHOOL
            <small>LOOKING BEYOND THE HORIZON</small>
        </span>
